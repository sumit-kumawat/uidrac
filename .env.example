# ═══════════════════════════════════════════════════════════════
# Universal iDRAC Console — local / lab Docker (docker compose up)
# Config slug / images: uidrac (see IDRAC_CONSOLE_IMAGE)
# Copy to .env:  cp .env.example .env
# Replace secrets:  bash scripts/generate-keys.sh --write
# For production on a VM use:  cp .env.selfhosted.example .env
# ═══════════════════════════════════════════════════════════════
#
# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  OPEN SOURCE SECURITY WARNING (uidrac / MIT repo only)                   ║
# ║  The JWT, DB, and encryption values below are TEMPORARY LAB DEFAULTS.    ║
# ║  They are committed in this public repository — anyone can read them.    ║
# ║  Using them outside localhost, or on any internet-facing host, is         ║
# ║  INSECURE (session forgery, DB access, decrypting stored iDRAC creds).    ║
# ║  Before production or shared networks run:                               ║
# ║    bash scripts/generate-keys.sh --write                                 ║
# ║  and never commit your real .env file.                                   ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── Database (Postgres 16) ──
POSTGRES_USER=idrac
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=idrac
POSTGRES_URL=postgresql://idrac:devpassword@postgres:5432/idrac

# ── Redis 7 ──
REDIS_URL=redis://redis:6379

# ── JWT / sessions (lab defaults — replace with generate-keys.sh --write) ──
JWT_SECRET=dev-jwt-secret-change-in-production
REFRESH_SECRET=dev-refresh-secret-change-in-production

# ── iDRAC credential encryption (lab default — replace before real use) ──
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Self-hosted LAN (default for docker-compose.yml) ──
DEPLOYMENT_MODE=selfhosted
REQUIRE_EDGE_AGENT=false

# Browser URLs when using exposed ports 3000 / 4000 / 6080
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_CONSOLE_URL=http://localhost:6080/console
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Console gateway ──
IDRAC_CONSOLE_IMAGE=uidrac:legacy
CONSOLE_IDLE_TIMEOUT=1800
CONSOLE_MAX_PER_TENANT=10

# ── SMTP (optional — alerts / mail) ──
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=CHANGE_ME
# SMTP_FROM="Universal iDRAC Console <noreply@example.com>"

NODE_ENV=development
